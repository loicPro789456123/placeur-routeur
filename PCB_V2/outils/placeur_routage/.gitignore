# Fichiers produits, jamais suivis (lot D ; contrat §1.3, §0.2-5, §6.1).

# moteur construit par cargo
/target/

# dossiers de sortie par défaut de placeur.py (<dossier de la carte>/<nom>_resultats/), où qu'ils soient
*_resultats/

# écritures atomiques interrompues (<nom>.tmp), caches de Python
*.tmp
__pycache__/
*.pyc

# sorties de travail des anciens outils : seules les références déjà suivies restent, jusqu'à la bascule de §6.1
/sorties/*
